# live_call configuration. Put real values in your Hermes .env
# ($HERMES_HOME/.env) — the gateway passes its environment to the room server.

# ── Required for a talking call ──────────────────────────────────────────────
# Google AI Studio key for Gemini Live. Without it the plugin runs in `echo`
# mode (your voice is echoed back), which is useful for verifying audio.
GEMINI_API_KEY=

# ── Reachability ─────────────────────────────────────────────────────────────
# Leave empty to use the bundled Cloudflare quick-tunnel supervisor.
# Set it to a stable public base URL (named Cloudflare tunnel, your own
# reverse proxy, ngrok, …) for a permanent link host — recommended for
# anything beyond casual use, since quick-tunnel hostnames change on restart.
# LIVE_CALL_PUBLIC_URL=https://calls.example.com

# Where the room server listens locally. Keep it on loopback: the tunnel (or
# your proxy) is the only thing that should reach it.
# LIVE_CALL_BIND=127.0.0.1:8199

# ── Behaviour ────────────────────────────────────────────────────────────────
# Realtime model. Gemini Live IDs are not returned by ListModels — trust the
# docs, not the model listing.
# LIVE_CALL_MODEL=gemini-3.1-flash-live-preview

# Force a pipeline: `echo` (no key needed, echoes your audio) or `gemini`.
# Default: gemini when GEMINI_API_KEY is set, otherwise echo.
# LIVE_CALL_PIPELINE=echo

# Replace the assembled persona (SOUL.md + active personality) with a file.
# LIVE_CALL_SYSTEM_FILE=/path/to/system_prompt.md

# Set to 0 to stop injecting memory and recent-conversation context.
# LIVE_CALL_CONTEXT=1

# Transcripts and logs. Defaults to $HERMES_HOME/workspace/live_calls
# LIVE_CALL_RECORDINGS_DIR=

# Interpreter for the room server. Defaults to the plugin's own .venv.
# LIVE_CALL_PYTHON=

# Path to cloudflared, if not on PATH or in ./bin
# LIVE_CALL_CLOUDFLARED=
